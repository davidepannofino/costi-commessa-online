DATABASE_URL=postgresql://utente:password@host/nomedb?sslmode=require
PORT=3001
# Stringa casuale lunga e segreta usata per firmare i token di accesso (JWT).
# Da impostare anche nelle variabili d'ambiente del servizio su Render.
JWT_SECRET=cambia_questo_valore_con_una_stringa_casuale_lunga

# Chiave API Resend (dashboard Resend > API Keys), per l'invio dell'email di reset password.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mittente delle email. Finché non hai un dominio verificato su Resend, usa il
# mittente di test onboarding@resend.dev (consegna solo alla tua email Resend).
# Quando avrai un dominio verificato, cambia solo questa riga.
EMAIL_MITTENTE=Costi Commessa <onboarding@resend.dev>
# URL pubblico del frontend, usato per costruire il link nell'email di reset.
FRONTEND_URL=https://costi-commessa-frontend.onrender.com
