DATABASE_URL=postgresql://utente:password@host/nomedb?sslmode=require
PORT=3001
# Stringa casuale lunga e segreta usata per firmare i token di accesso (JWT).
# Da impostare anche nelle variabili d'ambiente del servizio su Render.
JWT_SECRET=cambia_questo_valore_con_una_stringa_casuale_lunga

# Chiave API Resend (dashboard Resend > API Keys), per l'invio dell'email di reset password.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mittente delle email. Finché non hai un dominio verificato su Resend, usa il
# mittente di test onboarding@resend.dev (consegna solo alla tua email Resend).
# Quando avrai un dominio verificato, cambia solo questa riga.
EMAIL_MITTENTE=Commexa <onboarding@resend.dev>
# URL pubblico del frontend, usato per costruire il link nell'email di reset,
# nelle email di scadenza della prova, e i redirect di ritorno da Stripe.
FRONTEND_URL=https://costi-commessa-frontend.onrender.com

# Segreto della rotta di manutenzione POST /api/manutenzione/avvisi-prova, che
# manda gli avvisi di scadenza della prova. Lo stesso valore va messo nei
# segreti del repository su GitHub (Settings > Secrets > Actions) come
# SEGRETO_MANUTENZIONE, insieme a URL_BACKEND con l'indirizzo del backend.
#
# SE QUESTA VARIABILE MANCA, LA ROTTA E' CHIUSA e risponde 401 a chiunque: e'
# la direzione sicura. Una variabile dimenticata su un ambiente nuovo lascia
# gli avvisi non mandati, non la rotta aperta a chiunque la trovi.
SEGRETO_MANUTENZIONE=cambia_questo_valore_con_una_stringa_casuale_lunga

# Chiavi Stripe (dashboard Stripe > Developers > API keys). Le chiavi sk_test_/
# pk_test_ sono per la modalità test; passare a quelle vere (sk_live_/pk_live_)
# non richiede altre modifiche al codice.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Firma del webhook (dashboard Stripe > Developers > Webhooks > il tuo endpoint,
# oppure stampata da "stripe listen" in locale). Necessaria per verificare che
# le richieste al webhook arrivino davvero da Stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Archivio dei documenti DDT (Cloudflare R2) ------------------------------
# Se queste quattro variabili ci sono, i file dei DDT vengono salvati su R2 e
# nel database resta solo il riferimento. Se mancano, i file restano dentro
# Postgres: comodo in locale, ma il piano gratuito di Neon (0,5 GB) si riempie
# in pochi mesi con qualche centinaio di documenti al mese.
#
# Dove trovarle: dash.cloudflare.com > R2 > Manage API Tokens > Create API Token
# (permesso "Object Read & Write" sul bucket). L'endpoint è mostrato nella
# pagina del bucket e ha la forma https://<id-account>.r2.cloudflarestorage.com
R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_BUCKET=costi-commessa-ddt
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facoltative: quota per azienda e tetto complessivo, in MB. Se non le imposti
# valgono 3000 MB per azienda e 9000 MB in tutto con R2 attivo (10 GB gratuiti),
# oppure 100 MB e 350 MB con i file dentro il database.
# QUOTA_ALLEGATI_MB=3000
# TETTO_ALLEGATI_MB=9000

# --- Lettura delle fatture PDF con Google Document AI (SERVIZIO A PAGAMENTO) --
# È l'unico pezzo a pagamento dell'applicazione, e riguarda SOLO i PDF: le
# fatture XML si leggono gratis e restano la strada principale.
# Se queste variabili mancano, l'app funziona lo stesso: i PDF vengono letti
# con il riconoscimento testuale di base e l'utente viene avvisato.
#
# LA CHIAVE NON VA MAI DENTRO IL PROGETTO. In locale tienila fuori (es.
# C:/Users/<tu>/.chiavi/...json) e metti qui il percorso. Su Render usa
# "Secret Files": carica il JSON e punta GOOGLE_APPLICATION_CREDENTIALS al
# percorso dove Render lo monta (di norma /etc/secrets/<nomefile>).
GOOGLE_APPLICATION_CREDENTIALS=C:/percorso/fuori/dal/progetto/chiave.json
# In alternativa, se i Secret Files non sono disponibili, si può incollare
# l'intero contenuto del file JSON in questa variabile, su una riga sola:
# GOOGLE_CREDENTIALS_JSON=<tutto il JSON della chiave, da { a }>
# (qui non si scrive un esempio somigliante a una chiave vera: farebbe
#  scattare il controllo di strumenti/pre-commit, ed è giusto così)

# Identificatori del processore (non sono segreti): numero del progetto,
# regione del processore e suo id.
DOCUMENTAI_PROJECT=000000000000
DOCUMENTAI_LOCATION=eu
DOCUMENTAI_PROCESSOR=xxxxxxxxxxxxxxxx

# Freni sulla spesa. Document AI si paga a pagina: questi limiti fermano
# l'applicazione prima che lo faccia la fattura di Google.
# DOCUMENTAI_MAX_PAGINE=15          # per singolo documento
# DOCUMENTAI_MAX_PAGINE_MESE=500    # tetto mensile complessivo
# DOCUMENTAI_SOGLIA_CONFIDENZA=0.7  # sotto questa, il campo è "da controllare"
